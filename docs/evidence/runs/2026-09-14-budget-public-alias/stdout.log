      "sql": "CREATE TABLE cpu_action_decisions (\n        decision_id TEXT NOT NULL COLLATE BINARY PRIMARY KEY,\n        scope TEXT NOT NULL COLLATE BINARY,\n        record_json TEXT NOT NULL\n    )",
