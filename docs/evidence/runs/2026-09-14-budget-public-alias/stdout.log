      "sql": "CREATE TABLE cpu_action_recovery (\n        scope TEXT NOT NULL COLLATE BINARY PRIMARY KEY,\n        binding_json TEXT NOT NULL,\n        nonce TEXT NOT NULL COLLATE BINARY,\n        state TEXT NOT NULL CHECK (state IN ('IN_PROGRESS','COMPLETE')),\n        summary_json TEXT\n    )",
