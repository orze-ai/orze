        "kind": "program",
        "source": "import numpy as np\nfrom sklearn.preprocessing import StandardScaler, PolynomialFeatures\nfrom sklearn.linear_model import Ridge\nfrom sklearn.svm import SVR\nfrom sklearn.ensemble import ExtraTreesRegressor, HistGradientBoostingRegressor\nfrom sklearn.model_selection import GroupKFold\nfrom sklearn.pipeline import make_pipeline\n\n\ndef _feats(X):\n    X = np.asarray(X, dtype=float)\n    cyl = X[:, 0]\n    disp = X[:, 1]\n    hp = X[:, 2]\n    wt = X[:, 3]\n    acc = X[:, 4]\n    yr = X[:, 5]\n    org = X[:, 6]\n    e = 1e-6\n    cols = [cyl, disp, hp, wt, acc, yr,\n            np.log(np.clip(disp, e, None)),\n            np.log(np.clip(hp, e, None)),\n            np.log(np.clip(wt, e, None)),\n            hp / (wt + e), disp / (cyl + e), wt / (hp + e),\n            hp / (disp + e), acc * hp / (wt + e)]\n    for v in (1.0, 2.0, 3.0):\n        cols.append((np.abs(org - v) < 0.5).astype(float))\n    return np.column_stack(cols)\n\n\ndef _models(seed):\n    return [make_pipeline(StandardScaler(), PolynomialFeatures(2, include_bias=False), StandardScaler(), Ridge(alpha=100.0)),\n            make_pipeline(StandardScaler(), SVR(C=30.0, gamma=0.05, epsilon=0.05)),\n            ExtraTreesRegressor(n_estimators=400, max_features=0.6, min_samples_leaf=1, random_state=seed, n_jobs=1),\n            HistGradientBoostingRegressor(learning_rate=0.06, max_leaf_nodes=15, min_samples_leaf=8, l2_regularization=1.0, max_iter=300, early_stopping=False, random_state=seed)]\n\n\ndef _fit_pred(m, Ftr, ltr, Fev):\n    m.fit(Ftr, ltr)\n    return np.exp(np.clip(m.predict(Fev), -2.0, 6.0))\n\n\ndef _simplex(k, n):\n    out = []\n\n    def rec(pref, rem, left):\n        if left == 1:\n            out.append(pref + [rem])\n            return\n        for i in range(rem + 1):\n            rec(pref + [i], rem - i, left - 1)\n\n    rec([], n, k)\n    return np.array(out, dtype=float) / float(n)\n\n\ndef fit_predict(X_train, y_train, X_eval, seed):\n    Xtr = np.asarray(X_train, dtype=float)\n    ytr = np.asarray(y_train, dtype=float).ravel()\n    Ftr = _feats(Xtr)\n    Fev = _feats(np.asarray(X_eval, dtype=float))\n    ltr = np.log(np.clip(ytr, 1e-3, None))\n    groups = Xtr[:, 5]\n    ng = int(np.unique(groups).size)\n    k = 4\n    w = np.full(k, 1.0 / k)\n    if ng >= 3:\n        ns = min(5, ng)\n        oof = np.zeros((Xtr.shape[0], k))\n        ok = np.zeros(Xtr.shape[0], dtype=bool)\n        gkf = GroupKFold(n_splits=ns)\n        for tr, va in gkf.split(Ftr, ltr, groups):\n            for j, m in enumerate(_models(seed)):\n                oof[va, j] = _fit_pred(m, Ftr[tr], ltr[tr], Ftr[va])\n            ok[va] = True\n        P = oof[ok]\n        t = ytr[ok]\n        if P.shape[0] >= 20 and np.all(np.isfinite(P)):\n            cands = _simplex(k, 10)\n            mse = (((cands @ P.T) - t[None, :]) ** 2).mean(axis=1)\n            best = cands[int(np.argmin(mse))]\n            w = 0.5 * best + 0.5 * np.full(k, 1.0 / k)\n    preds = np.zeros(Fev.shape[0], dtype=float)\n    for j, m in enumerate(_models(seed)):\n        preds = preds + w[j] * _fit_pred(m, Ftr, ltr, Fev)\n    med = float(np.median(ytr))\n    preds = np.where(np.isfinite(preds), preds, med)\n    return np.clip(preds, 5.0, 60.0)\n"
