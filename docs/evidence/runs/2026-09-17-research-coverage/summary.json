      "selected_candidate": {
        "kind": "program",
        "source": "import numpy as np\nfrom sklearn.linear_model import Ridge\nfrom sklearn.preprocessing import StandardScaler, PolynomialFeatures\nfrom sklearn.pipeline import make_pipeline\nfrom sklearn.ensemble import HistGradientBoostingRegressor\nfrom sklearn.model_selection import GroupKFold\n\nEPS = 1e-6\n\ndef _feat(X):\n    X = np.asarray(X, dtype=float)\n    cyl = X[:, 0]; disp = X[:, 1]; hp = X[:, 2]; wt = X[:, 3]\n    acc = X[:, 4]; yr = X[:, 5]; org = X[:, 6]\n    cols = [cyl, disp, hp, wt, acc, yr,\n            np.log(np.maximum(disp, EPS)), np.log(np.maximum(hp, EPS)),\n            np.log(np.maximum(wt, EPS)), np.log(np.maximum(acc, EPS)),\n            hp / (wt + EPS), disp / (cyl + EPS), wt / (disp + EPS),\n            hp / (disp + EPS), wt / (cyl + EPS), 1000.0 / (wt + EPS),\n            wt * acc / 1000.0, yr - 70.0,\n            (org < 1.5).astype(float), ((org >= 1.5) & (org < 2.5)).astype(float),\n            (org >= 2.5).astype(float)]\n    return np.column_stack(cols)\n\ndef _ridge(alpha):\n    return make_pipeline(StandardScaler(),\n                        PolynomialFeatures(degree=2, include_bias=False),\n                        StandardScaler(),\n                        Ridge(alpha=alpha))\n\ndef _hgb(seed):\n    return HistGradientBoostingRegressor(loss='squared_error', learning_rate=0.06,\n                                         max_iter=350, max_leaf_nodes=15,\n                                         min_samples_leaf=8, l2_regularization=1.0,\n                                         early_stopping=False, random_state=seed)\n\ndef fit_predict(X_train, y_train, X_eval, seed):\n    Xtr = np.asarray(X_train, dtype=float)\n    Xev = np.asarray(X_eval, dtype=float)\n    y = np.asarray(y_train, dtype=float).ravel()\n    ly = np.log(np.maximum(y, EPS))\n    Ftr = _feat(Xtr)\n    Fev = _feat(Xev)\n    groups = Xtr[:, 5]\n    alphas = [0.3, 1.0, 3.0, 10.0, 30.0, 100.0]\n    n_groups = int(np.unique(groups).size)\n    n_splits = int(min(5, max(2, n_groups)))\n    ridge_oof = np.zeros((len(alphas), y.size))\n    boost_oof = np.zeros(y.size)\n    ok = False\n    if n_groups >= 2 and y.size >= 20:\n        try:\n            gkf = GroupKFold(n_splits=n_splits)\n            for tr, te in gkf.split(Ftr, ly, groups):\n                for i, a in enumerate(alphas):\n                    m = _ridge(a)\n                    m.fit(Ftr[tr], ly[tr])\n                    ridge_oof[i, te] = m.predict(Ftr[te])\n                b = _hgb(seed)\n                b.fit(Ftr[tr], ly[tr])\n                boost_oof[te] = b.predict(Ftr[te])\n            ok = True\n        except Exception:\n            ok = False\n    if ok:\n        errs = []\n        for i in range(len(alphas)):\n            p = np.exp(np.clip(ridge_oof[i], -3.0, 5.0))\n            errs.append(float(np.mean((p - y) ** 2)))\n        bi = int(np.argmin(errs))\n        best_w = 1.0\n        best_e = None\n        for w in np.linspace(0.0, 1.0, 21):\n            p = np.exp(np.clip(w * ridge_oof[bi] + (1.0 - w) * boost_oof, -3.0, 5.0))\n            e = float(np.mean((p - y) ** 2))\n            if best_e is None or e < best_e:\n                best_e = e\n                best_w = float(w)\n    else:\n        bi = 1\n        best_w = 0.5\n    m = _ridge(alphas[bi])\n    m.fit(Ftr, ly)\n    pr = np.asarray(m.predict(Fev), dtype=float).ravel()\n    b = _hgb(seed)\n    b.fit(Ftr, ly)\n    pb = np.asarray(b.predict(Fev), dtype=float).ravel()\n    lp = best_w * pr + (1.0 - best_w) * pb\n    lp = np.nan_to_num(lp, nan=float(np.mean(ly)), posinf=5.0, neginf=-3.0)\n    out = np.exp(np.clip(lp, -3.0, 5.0))\n    lo = float(max(1.0, np.min(y) * 0.5))\n    hi = float(np.max(y) * 1.5)\n    out = np.clip(np.nan_to_num(out, nan=float(np.mean(y)), posinf=hi, neginf=lo), lo, hi)\n    return out.astype(float).ravel()\n"
      },
