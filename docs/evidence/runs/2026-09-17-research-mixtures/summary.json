        "kind": "program",
        "source": "import numpy as np\nfrom sklearn.base import clone\nfrom sklearn.pipeline import make_pipeline\nfrom sklearn.preprocessing import StandardScaler, PolynomialFeatures\nfrom sklearn.linear_model import Ridge, LinearRegression\nfrom sklearn.ensemble import ExtraTreesRegressor, RandomForestRegressor\nfrom sklearn.svm import SVR\nfrom sklearn.model_selection import GroupKFold, KFold\n\n\ndef _aug(X):\n    X = np.asarray(X, dtype=float)\n    c = X[:, 0]; s = X[:, 1]; f = X[:, 2]; w = X[:, 3]\n    sp = X[:, 4]; ca = X[:, 5]; fa = X[:, 6]\n    e = 1e-6\n    b = c + s + f\n    agg = ca + fa\n    tot = b + w + sp + agg\n    cols = [X,\n            (w / (c + e))[:, None],\n            (w / (b + e))[:, None],\n            (sp / (b + e))[:, None],\n            (b / (tot + e))[:, None],\n            (w / (tot + e))[:, None],\n            (agg / (tot + e))[:, None],\n            (fa / (agg + e))[:, None],\n            ((s + f) / (b + e))[:, None],\n            ((w + sp) / (tot + e))[:, None],\n            tot[:, None]]\n    A = np.hstack(cols)\n    return np.nan_to_num(A, nan=0.0, posinf=0.0, neginf=0.0)\n\n\ndef _models(seed):\n    return [\n        make_pipeline(StandardScaler(),\n                      PolynomialFeatures(degree=2, include_bias=False),\n                      StandardScaler(), Ridge(alpha=100.0)),\n        make_pipeline(StandardScaler(), Ridge(alpha=10.0)),\n        make_pipeline(StandardScaler(),\n                      SVR(C=8.0, gamma=\"scale\", epsilon=1.0)),\n        ExtraTreesRegressor(n_estimators=400, max_features=0.75,\n                            min_samples_leaf=2, random_state=seed, n_jobs=1),\n        RandomForestRegressor(n_estimators=400, max_features=0.75,\n                              min_samples_leaf=4, random_state=seed, n_jobs=1),\n    ]\n\n\ndef fit_predict(X_train, y_train, X_eval, seed, train_groups=None):\n    Xtr = _aug(X_train)\n    Xev = _aug(X_eval)\n    y = np.asarray(y_train, dtype=float).ravel()\n    n = Xtr.shape[0]\n    models = _models(seed)\n    splits = None\n    if train_groups is not None:\n        g = np.asarray(train_groups)\n        ng = int(np.unique(g).shape[0])\n        if ng >= 2:\n            k = max(2, min(5, ng))\n            splits = list(GroupKFold(n_splits=k).split(Xtr, y, groups=g))\n    if splits is None:\n        k = max(2, min(5, n))\n        splits = list(KFold(n_splits=k, shuffle=True,\n                            random_state=seed).split(Xtr))\n    oof = np.zeros((n, len(models)), dtype=float)\n    seen = np.zeros(n, dtype=bool)\n    for tr, te in splits:\n        if tr.shape[0] < 3 or te.shape[0] < 1:\n            continue\n        for j, m in enumerate(models):\n            mm = clone(m)\n            mm.fit(Xtr[tr], y[tr])\n            oof[te, j] = mm.predict(Xtr[te])\n        seen[te] = True\n    P = np.zeros((Xev.shape[0], len(models)), dtype=float)\n    for j, m in enumerate(models):\n        mm = clone(m)\n        mm.fit(Xtr, y)\n        P[:, j] = mm.predict(Xev)\n    lo = float(np.min(y)); hi = float(np.max(y)); mu = float(np.mean(y))\n    if seen.sum() >= max(5, len(models) + 2):\n        oof = np.nan_to_num(oof, nan=mu, posinf=hi, neginf=lo)\n        blender = LinearRegression(positive=True, fit_intercept=True)\n        blender.fit(oof[seen], y[seen])\n        pred = blender.predict(P)\n    else:\n        pred = P.mean(axis=1)\n    pred = np.asarray(pred, dtype=float).ravel()\n    pred = np.nan_to_num(pred, nan=mu, posinf=hi, neginf=lo)\n    return np.clip(pred, lo, hi)\n"
